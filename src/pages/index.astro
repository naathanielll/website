---
// src/pages/index.astro
import '../styles/global.css';

const slides = [
  {
    image: "/slides/slide-1.jpg",
    title: "General Interest Meetings & Events",
    caption: "Connect with fellow accounting majors and explore upcoming workshops"
  },
  {
    image: "/slides/slide-2.jpg",
    title: "VITA Tax Preparation Program",
    caption: "Hands-on tax compliance training and direct community service in NYC"
  },
  {
    image: "/slides/slide-3.jpg",
    title: "Firm Panels & Recruiter Networking",
    caption: "Direct recruiting pipelines into public and private accounting"
  }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Accounting Society | Hunter College</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950 flex flex-col justify-between">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0e0716]/95 border-b border-[#5F259F]/30">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        
        <!-- Brand / Crest -->
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="/logo.jpg" 
            alt="Hunter Accounting Logo" 
            class="w-9 h-9 rounded-xl object-contain bg-[#190e2b] border border-[#5F259F] p-1"
            onerror="this.src='/logo.png'; this.onerror=null;"
          />
          <div class="flex flex-col">
            <span class="font-bold text-white text-sm tracking-tight group-hover:text-[#FFC72A] transition">Accounting Society</span>
            <span class="text-[10px] text-neutral-400 font-medium tracking-wider uppercase">Hunter College</span>
          </div>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden lg:flex items-center gap-1 text-sm font-medium text-neutral-300">
          <a href="/" class="px-3 py-2 rounded-lg text-[#FFC72A] bg-[#190e2b]/50">Home</a>

          <!-- VITA Dropdown -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
              <span>VITA</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-56 z-50">
              <div class="rounded-xl bg-[#5F259F] border border-[#FFC72A]/40 shadow-2xl p-2 space-y-1">
                <a href="/vita/program-overview" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Program Overview & Volunteering
                </a>
                <a href="/vita/vita-eboard2" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  VITA E-Board
                </a>
                <a href="/vita/client-tax" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Info for Taxpayers
                </a>
              </div>
            </div>
          </div>

          <a href="/events" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">Events</a>

          <!-- Education Dropdown -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
              <span>Education</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-60 z-50">
              <div class="rounded-xl bg-[#5F259F] border border-[#FFC72A]/40 shadow-2xl p-2 space-y-1">
                <a href="/education/cpa-requirements" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  CPA Requirements
                </a>
                <a href="/education/major-requirements" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Major Requirements
                </a>
                <a href="/education/masters" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Masters In Accounting
                </a>
                <a href="/education/faculty" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Advisor + Faculty
                </a>
              </div>
            </div>
          </div>

          <a href="#contact" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">Contact</a>
        </nav>

        <!-- Header CTA -->
        <div class="flex items-center gap-2.5">
          <a 
            href="https://docs.google.com/forms/d/e/1FAIpQLSeUEKzWtcRuj5kBHhk-J9ckwZqmzKj_OCR24RObOFJT5PO_IQ/viewform" 
            target="_blank" 
            class="px-3.5 py-2 text-xs font-bold rounded-xl bg-[#FFC72A] text-neutral-950 hover:bg-[#e6b224] transition shadow-md shadow-[#FFC72A]/10"
          >
            Join Society
          </a>

          <button 
            id="mobile-menu-btn" 
            class="lg:hidden p-2 rounded-xl text-neutral-300 hover:text-[#FFC72A] hover:bg-[#190e2b] border border-[#5F259F]/40 transition" 
            aria-label="Toggle navigation menu"
          >
            <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Drawer -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-[#5F259F]/30 bg-[#0e0716] px-6 py-4 space-y-4 max-h-[80vh] overflow-y-auto">
        <div class="space-y-1">
          <a href="/" class="block px-3 py-2 rounded-lg text-sm font-medium hover:bg-[#190e2b] hover:text-[#FFC72A] transition">Home</a>
          <a href="/events" class="block px-3 py-2 rounded-lg text-sm font-medium hover:bg-[#190e2b] hover:text-[#FFC72A] transition">Events</a>
        </div>

        <div class="space-y-1 pt-2 border-t border-[#5F259F]/20">
          <span class="px-3 text-[11px] font-bold uppercase tracking-wider text-[#FFC72A]">VITA Program</span>
          <a href="/vita/program-overview" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">• Program Overview & Volunteering</a>
          <a href="/vita/vita-eboard2" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">• VITA E-Board</a>
          <a href="/vita/client-tax" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">• Info for Taxpayers</a>
        </div>

        <div class="space-y-1 pt-2 border-t border-[#5F259F]/20">
          <span class="px-3 text-[11px] font-bold uppercase tracking-wider text-[#FFC72A]">Education</span>
          <a href="/education/cpa-requirements" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">• CPA Requirements</a>
          <a href="/education/major-requirements" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">• Major Requirements</a>
          <a href="/education/masters" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">• Masters In Accounting</a>
          <a href="/education/faculty" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">• Advisor + Faculty</a>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-5xl mx-auto px-6 py-8 space-y-12 w-full flex-1">
      
      <!-- 1. IMAGE CAROUSEL (At the very top) -->
      <section class="relative w-full rounded-3xl overflow-hidden bg-[#190e2b]/80 border border-[#5F259F]/40 shadow-2xl group/carousel" id="carousel">
        <div class="relative w-full h-64 sm:h-96 md:h-[420px] overflow-hidden">
          {slides.map((slide, index) => (
            <div 
              class={`carousel-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
              data-index={index}
            >
              <img 
                src={slide.image} 
                alt={slide.title} 
                class="w-full h-full object-cover object-center"
                onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-[#281344] to-[#0e0716] text-center p-6 space-y-2\'><span class=\'text-3xl\'>📸</span><h3 class=\'text-lg font-bold text-white\'>Society In Action</h3><p class=\'text-xs text-neutral-400\'>Add pictures to /public/slides/</p></div>'"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0e0716] via-[#0e0716]/40 to-transparent flex items-end p-6 sm:p-8">
                <div class="space-y-1 max-w-xl">
                  <span class="text-[10px] sm:text-xs uppercase tracking-wider font-bold text-[#FFC72A] bg-[#5F259F]/70 px-2.5 py-0.5 rounded-full border border-[#FFC72A]/30 inline-block mb-1">
                    Hunter Accounting Society
                  </span>
                  <h3 class="text-lg sm:text-2xl font-bold text-white drop-shadow-md">
                    {slide.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-neutral-300 drop-shadow">
                    {slide.caption}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <button 
          id="prev-slide" 
          class="absolute left-4 top-1/2 -translate-y-1/2 z-20 p-2.5 rounded-full bg-[#0e0716]/75 hover:bg-[#5F259F] text-white border border-[#5F259F]/40 transition opacity-80 hover:opacity-100 shadow-lg"
          aria-label="Previous slide"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button 
          id="next-slide" 
          class="absolute right-4 top-1/2 -translate-y-1/2 z-20 p-2.5 rounded-full bg-[#0e0716]/75 hover:bg-[#5F259F] text-white border border-[#5F259F]/40 transition opacity-80 hover:opacity-100 shadow-lg"
          aria-label="Next slide"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <div class="absolute bottom-4 right-6 z-20 flex items-center gap-2">
          {slides.map((_, index) => (
            <button 
              class={`carousel-dot h-2 rounded-full transition-all duration-300 ${index === 0 ? 'w-6 bg-[#FFC72A]' : 'w-2 bg-white/50 hover:bg-white'}`}
              data-slide-to={index}
              aria-label={`Go to slide ${index + 1}`}
            />
          ))}
        </div>
      </section>

      <!-- 2. MISSION STATEMENT -->
      <section class="p-8 sm:p-10 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-2xl space-y-4">
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider font-bold text-[#FFC72A]">Hunter College • Department of Economics & Accounting</span>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">Our Mission</h1>
          <div class="w-16 h-1 bg-[#FFC72A] rounded-full"></div>
        </div>
        <p class="text-sm sm:text-base text-neutral-200 leading-relaxed">
          Our mission is to educate, foster social interaction among members, alumni and industry professionals and provide career opportunities in the accounting profession. New York is the largest hub of financial services in the world and there is significant interest in the industry among Hunter College’s student body.
        </p>
      </section>

      <!-- 3. UPCOMING EVENTS IN NEXT WEEK (With Link to Calendar) -->
      <section class="p-8 sm:p-10 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-2xl space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#5F259F]/30 pb-4">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Upcoming Events Next Week</h2>
            <p class="text-xs text-neutral-400">Join our upcoming workshops and meetings</p>
          </div>
          <a 
            href="/events" 
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#5F259F] hover:bg-[#722cbd] text-white text-xs font-bold transition whitespace-nowrap shadow-md shadow-[#5F259F]/20"
          >
            <span>View Full Calendar</span>
            <span>→</span>
          </a>
        </div>

        <!-- Teaser Event Item -->
        <div class="p-5 rounded-2xl bg-[#0e0716]/60 border border-[#5F259F]/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <span class="text-xs font-semibold text-[#FFC72A] uppercase tracking-wider">Upcoming Event</span>
            <h3 class="text-base font-bold text-white">Club Fair Tabling</h3>
            <p class="text-xs sm:text-sm text-neutral-300">
              Meet current executive board members, learn about the club, and get details on upcoming events.
            </p>
          </div>
          <a 
            href="/events" 
            class="text-xs font-semibold text-[#FFC72A] underline hover:text-[#ffe07b] transition whitespace-nowrap self-start sm:self-center"
          >
            Check date & time on Calendar →
          </a>
        </div>
      </section>

      <!-- 4. VITA PROGRAM PARAGRAPH (With Link) -->
      <section class="p-8 sm:p-10 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-2xl space-y-4">
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider font-bold text-[#FFC72A]">Community Impact & Experience</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Volunteer Income Tax Assistance (VITA)</h2>
          <div class="w-16 h-1 bg-[#FFC72A] rounded-full"></div>
        </div>
        <p class="text-sm sm:text-base text-neutral-200 leading-relaxed">
          The Volunteer Income Tax Assistance (VITA) program provides free tax preparation services to underserved taxpayers, low-to-moderate-income individuals, persons with disabilities, and students. By participating as a certified IRS volunteer through Hunter's site, accounting students gain invaluable practical tax preparation experience, client interview skills, and community service recognition directly on their resume.
        </p>
        <div class="pt-2">
          <a 
            href="/vita/program-overview" 
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-[#5F259F] hover:bg-[#722cbd] text-white text-xs font-bold transition shadow-md shadow-[#5F259F]/20"
          >
            <span>Learn About VITA & Volunteering</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- 5. WHY BECOME A CPA & BECOME A MEMBER LINK -->
      <section class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-[#190e2b] via-[#160b28] to-[#0e0716] border border-[#5F259F]/40 shadow-2xl space-y-5">
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider font-bold text-[#FFC72A]">Career Advancement</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Why Become a CPA?</h2>
          <div class="w-16 h-1 bg-[#FFC72A] rounded-full"></div>
        </div>
        <p class="text-sm sm:text-base text-neutral-200 leading-relaxed">
          Earning your Certified Public Accountant (CPA) license is the premier credential in the financial world. It establishes unmatched professional credibility, commands significantly higher earning potential throughout your career, and qualifies you for executive leadership positions across public accounting, advisory, and corporate finance. The Accounting Society equips members with academic roadmaps, study resources, and recruitment pipelines to conquer the 150-credit requirement and pass the exam.
        </p>
        <div class="pt-2">
          <a 
            href="https://docs.google.com/forms/d/e/1FAIpQLSeUEKzWtcRuj5kBHhk-J9ckwZqmzKj_OCR24RObOFJT5PO_IQ/viewform" 
            target="_blank" 
            class="inline-block px-7 py-3 rounded-xl bg-[#FFC72A] text-neutral-950 font-bold hover:bg-[#e6b224] transition text-sm shadow-lg shadow-[#FFC72A]/10"
          >
            Become a Member Today
          </a>
        </div>
      </section>

      <!-- Contact Section -->
      <section id="contact" class="p-6 rounded-2xl bg-[#0e0716]/60 border border-[#5F259F]/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <h3 class="text-sm font-bold text-white">Questions? Reach out to our E-Board</h3>
          <p class="text-xs text-neutral-400">Email us directly: <a href="mailto:accountingsocietyhc@gmail.com" class="text-[#FFC72A] hover:underline">accountingsocietyhc@gmail.com</a></p>
        </div>
        <div class="flex items-center gap-3">
          <a href="https://www.instagram.com/accountingsocietyhc/" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg bg-[#5F259F] text-white text-xs font-semibold hover:bg-[#722cbd] transition">Instagram</a>
          <a href="https://www.linkedin.com/company/accounting-society-of-hunter-college/" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg bg-[#5F259F] text-white text-xs font-semibold hover:bg-[#722cbd] transition">LinkedIn</a>
        </div>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society. All rights reserved.</p>
    </footer>

    <!-- Client-side Script: Mobile Drawer & Slideshow Controller -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');

      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        iconOpen?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
      });

      const slides = document.querySelectorAll('.carousel-slide');
      const dots = document.querySelectorAll('.carousel-dot');
      const prevBtn = document.getElementById('prev-slide');
      const nextBtn = document.getElementById('next-slide');
      const carouselContainer = document.getElementById('carousel');

      let currentSlide = 0;
      let autoplayTimer: number | undefined;

      function updateSlide(targetIndex: number) {
        if (!slides.length) return;
        
        if (targetIndex < 0) currentSlide = slides.length - 1;
        else if (targetIndex >= slides.length) currentSlide = 0;
        else currentSlide = targetIndex;

        slides.forEach((slide, idx) => {
          if (idx === currentSlide) {
            slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
            slide.classList.add('opacity-100', 'z-10');
          } else {
            slide.classList.remove('opacity-100', 'z-10');
            slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === currentSlide) {
            dot.classList.remove('w-2', 'bg-white/50');
            dot.classList.add('w-6', 'bg-[#FFC72A]');
          } else {
            dot.classList.remove('w-6', 'bg-[#FFC72A]');
            dot.classList.add('w-2', 'bg-white/50');
          }
        });
      }

      function startAutoplay() {
        stopAutoplay();
        autoplayTimer = window.setInterval(() => {
          updateSlide(currentSlide + 1);
        }, 5000);
      }

      function stopAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
      }

      prevBtn?.addEventListener('click', () => {
        updateSlide(currentSlide - 1);
        startAutoplay();
      });

      nextBtn?.addEventListener('click', () => {
        updateSlide(currentSlide + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const index = Number((e.currentTarget as HTMLElement).dataset.slideTo);
          updateSlide(index);
          startAutoplay();
        });
      });

      carouselContainer?.addEventListener('mouseenter', stopAutoplay);
      carouselContainer?.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    </script>
  </body>
</html>
