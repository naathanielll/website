---
// src/pages/index.astro
import '../styles/global.css';
import officers from '../data/officers.json';

const slides = [
  {
    image: "/slides/slide-1.jpg",
    title: "General Interest Meetings & Events",
    caption: "Connect with fellow accounting majors and explore upcoming workshops"
  },
  {
    image: "/slides/slide-2.jpg",
    title: "VITA Tax Preparation Program",
    caption: "Hands-on tax compliance training and direct community service in NYC"
  },
  {
    image: "/slides/slide-3.jpg",
    title: "Firm Panels & Recruiter Networking",
    caption: "Direct recruiting pipelines into Big 4, mid-tier, and private corporate finance"
  }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Accounting Society | Hunter College</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950">

    <!-- Sticky Header Navigation with Mobile Support -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0e0716]/95 border-b border-[#5F259F]/30">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        
        <!-- Brand / Crest -->
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="/logo.jpg" 
            alt="Hunter Accounting Logo" 
            class="w-9 h-9 rounded-xl object-contain bg-[#190e2b] border border-[#5F259F] p-1"
            onerror="this.src='/logo.png'; this.onerror=null;"
          />
          <div class="flex flex-col">
            <span class="font-bold text-white text-sm tracking-tight group-hover:text-[#FFC72A] transition">Accounting Society</span>
            <span class="text-[10px] text-neutral-400 font-medium tracking-wider uppercase">Hunter College</span>
          </div>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden lg:flex items-center gap-1 text-sm font-medium text-neutral-300">
          <a href="/" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
            Home
          </a>

          <!-- VITA Dropdown -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
              <span>VITA</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-56 z-50">
              <div class="rounded-xl bg-[#5F259F] border border-[#FFC72A]/40 shadow-2xl p-2 space-y-1">
                <a href="/vita/program-overview" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Program Overview
                </a>
                <a href="/vita/vita-eboard2" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  VITA E-Board
                </a>
                <a href="/vita/client-tax" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Info for Taxpayers
                </a>
              </div>
            </div>
          </div>

          <!-- Events Link -->
          <a href="/events" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
            Events
          </a>

          <!-- Education Dropdown -->
          <div class="relative group py-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
              <span>Education</span>
              <svg class="w-3.5 h-3.5 text-neutral-400 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-60 z-50">
              <div class="rounded-xl bg-[#5F259F] border border-[#FFC72A]/40 shadow-2xl p-2 space-y-1">
                <a href="/education/cpa-requirements" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  CPA Requirements
                </a>
                <a href="/education/major-requirements" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Major Requirements
                </a>
                <a href="/education/masters" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Masters In Accounting
                </a>
                <a href="/education/faculty" class="block px-3 py-2 rounded-lg text-xs font-semibold text-purple-100 hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
                  Advisor + Faculty
                </a>
              </div>
            </div>
          </div>

          <a href="#resources" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
            Useful Links
          </a>
          <a href="#contact" class="px-3 py-2 rounded-lg hover:text-[#FFC72A] hover:bg-[#190e2b] transition">
            Contact us
          </a>
        </nav>

        <!-- Header Actions -->
        <div class="flex items-center gap-2.5">
          <a 
            href="https://docs.google.com/forms/d/e/1FAIpQLSeUEKzWtcRuj5kBHhk-J9ckwZqmzKj_OCR24RObOFJT5PO_IQ/viewform" 
            target="_blank" 
            class="px-3 sm:px-4 py-2 text-xs font-bold rounded-xl bg-[#FFC72A] text-neutral-950 hover:bg-[#e6b224] transition shadow-md shadow-[#FFC72A]/10"
          >
            Join Society
          </a>

          <button 
            id="mobile-menu-btn" 
            class="lg:hidden p-2 rounded-xl text-neutral-300 hover:text-[#FFC72A] hover:bg-[#190e2b] border border-[#5F259F]/40 transition" 
            aria-label="Toggle navigation menu"
          >
            <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Collapsible Navigation Drawer -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-[#5F259F]/30 bg-[#0e0716] px-6 py-4 space-y-4 max-h-[80vh] overflow-y-auto">
        <div class="space-y-1">
          <a href="/" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-medium hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
            Home
          </a>
          <a href="/events" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-medium hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
            Events
          </a>
        </div>

        <div class="space-y-1 pt-2 border-t border-[#5F259F]/20">
          <span class="px-3 text-[11px] font-bold uppercase tracking-wider text-[#FFC72A]">VITA Program</span>
          <a href="/vita/program-overview" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">
            • Program Overview
          </a>
          <a href="/vita/vita-eboard2" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">
            • VITA E-Board
          </a>
          <a href="/vita/client-tax" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">
            • Info for Taxpayers
          </a>
        </div>

        <div class="space-y-1 pt-2 border-t border-[#5F259F]/20">
          <span class="px-3 text-[11px] font-bold uppercase tracking-wider text-[#FFC72A]">Education</span>
          <a href="/education/cpa-requirements" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">
            • CPA Requirements
          </a>
          <a href="/education/major-requirements" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">
            • Major Requirements
          </a>
          <a href="/education/masters" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">
            • Masters In Accounting
          </a>
          <a href="/education/faculty" class="block px-3 py-1.5 rounded-lg text-xs text-neutral-300 hover:bg-[#190e2b] hover:text-white transition">
            • Advisor + Faculty
          </a>
        </div>

        <div class="space-y-1 pt-2 border-t border-[#5F259F]/20">
          <a href="#resources" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-medium hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
            Useful Links
          </a>
          <a href="#contact" class="mobile-nav-link block px-3 py-2 rounded-lg text-sm font-medium hover:bg-[#190e2b] hover:text-[#FFC72A] transition">
            Contact us
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-5xl mx-auto px-6 py-12 space-y-16">
      
      <!-- Club Hero Section -->
      <section class="space-y-5">
        <span class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFC72A] bg-[#5F259F]/30 border border-[#FFC72A]/40 rounded-full">
          Hunter College • Department of Economics & Accounting
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Accounting Society
        </h1>
        <p class="text-base sm:text-lg text-neutral-300 max-w-2xl leading-relaxed">
          Empowering Hunter students with technical workshops, CPA guidance, VITA tax preparation, and direct recruiting pipelines into public and private accounting.
        </p>
        <div class="flex flex-wrap gap-3 pt-2">
          <a 
            href="https://docs.google.com/forms/d/e/1FAIpQLSeUEKzWtcRuj5kBHhk-J9ckwZqmzKj_OCR24RObOFJT5PO_IQ/viewform" 
            target="_blank" 
            class="px-6 py-3 rounded-xl bg-[#FFC72A] text-neutral-950 font-bold hover:bg-[#e6b224] transition text-sm shadow-lg shadow-[#FFC72A]/10"
          >
            Become a Member
          </a>
          <a 
            href="/events" 
            class="px-6 py-3 rounded-xl bg-[#190e2b] border border-[#5F259F]/50 text-purple-100 font-semibold hover:border-[#FFC72A]/50 hover:bg-[#23143a] transition text-sm"
          >
            Upcoming Events Calendar →
          </a>
        </div>
      </section>

      <!-- Image Slideshow Section -->
      <section class="relative w-full rounded-3xl overflow-hidden bg-[#190e2b]/80 border border-[#5F259F]/40 shadow-2xl group/carousel" id="carousel">
        <div class="relative w-full h-64 sm:h-96 md:h-[420px] overflow-hidden">
          {slides.map((slide, index) => (
            <div 
              class={`carousel-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
              data-index={index}
            >
              <img 
                src={slide.image} 
                alt={slide.title} 
                class="w-full h-full object-cover object-center"
                onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-[#281344] to-[#0e0716] text-center p-6 space-y-2\'><span class=\'text-3xl\'>📸</span><h3 class=\'text-lg font-bold text-white\'>Society In Action</h3><p class=\'text-xs text-neutral-400\'>Add pictures to /public/slides/</p></div>'"
              />
              
              <!-- Gradient Overlay with Caption -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#0e0716] via-[#0e0716]/40 to-transparent flex items-end p-6 sm:p-8">
                <div class="space-y-1 max-w-xl">
                  <span class="text-[10px] sm:text-xs uppercase tracking-wider font-bold text-[#FFC72A] bg-[#5F259F]/70 px-2.5 py-0.5 rounded-full border border-[#FFC72A]/30 inline-block mb-1">
                    ASHC Highlight
                  </span>
                  <h3 class="text-lg sm:text-2xl font-bold text-white drop-shadow-md">
                    {slide.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-neutral-300 drop-shadow">
                    {slide.caption}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Previous Button -->
        <button 
          id="prev-slide" 
          class="absolute left-4 top-1/2 -translate-y-1/2 z-20 p-2.5 rounded-full bg-[#0e0716]/75 hover:bg-[#5F259F] text-white border border-[#5F259F]/40 transition opacity-80 hover:opacity-100 shadow-lg"
          aria-label="Previous slide"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- Next Button -->
        <button 
          id="next-slide" 
          class="absolute right-4 top-1/2 -translate-y-1/2 z-20 p-2.5 rounded-full bg-[#0e0716]/75 hover:bg-[#5F259F] text-white border border-[#5F259F]/40 transition opacity-80 hover:opacity-100 shadow-lg"
          aria-label="Next slide"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Slide Indicators / Dots -->
        <div class="absolute bottom-4 right-6 z-20 flex items-center gap-2">
          {slides.map((_, index) => (
            <button 
              class={`carousel-dot h-2 rounded-full transition-all duration-300 ${index === 0 ? 'w-6 bg-[#FFC72A]' : 'w-2 bg-white/50 hover:bg-white'}`}
              data-slide-to={index}
              aria-label={`Go to slide ${index + 1}`}
            />
          ))}
        </div>
      </section>

      <!-- Why Join & Mission Section -->
      <section class="p-8 sm:p-10 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-2xl">
        <div class="grid md:grid-cols-12 gap-8 items-center">
          
          <!-- Emblem / Logo Column -->
          <div class="md:col-span-4 flex justify-center">
            <div class="relative w-44 sm:w-52 p-4 rounded-2xl bg-[#0e0716]/60 border border-[#5F259F]/40 flex items-center justify-center shadow-inner">
              <img 
                src="/hunter-hawk.png" 
                alt="Hunter College Logo" 
                class="w-full max-h-48 object-contain drop-shadow-[0_10px_20px_rgba(95,37,159,0.35)]"
                onerror="this.src='/logo.jpg'; this.onerror=null;"
              />
            </div>
          </div>

          <!-- Mission Content Column -->
          <div class="md:col-span-8 space-y-6">
            <div class="space-y-1">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-[#c084fc] tracking-tight">
                Why Join?
              </h2>
              <div class="w-16 h-1 bg-[#FFC72A] rounded-full"></div>
            </div>

            <ul class="space-y-3.5 text-xs sm:text-sm text-neutral-200 leading-relaxed">
              <li class="flex items-start gap-3">
                <span class="text-[#FFC72A] text-base leading-none mt-0.5 font-bold">▪</span>
                <span>
                  Our mission is to educate, foster social interaction among members, alumni, and industry professionals, and provide career opportunities in the accounting profession. New York is the largest hub of financial services in the world and there is significant interest in the industry among Hunter College’s student body.
                </span>
              </li>

              <li class="flex items-start gap-3">
                <span class="text-[#FFC72A] text-base leading-none mt-0.5 font-bold">▪</span>
                <span>
                  <strong>Student-run organization</strong> with over 200 active members.
                </span>
              </li>

              <li class="flex items-start gap-3">
                <span class="text-[#FFC72A] text-base leading-none mt-0.5 font-bold">▪</span>
                <span>
                  Events throughout the semester including networking opportunities, career workshops, and speaker panels—with our largest flagship events bringing together over 100 students.
                </span>
              </li>

              <li class="flex items-start gap-3">
                <span class="text-[#FFC72A] text-base leading-none mt-0.5 font-bold">▪</span>
                <span>
                  Community service initiatives such as the <strong>Volunteer Income Tax Assistance (VITA)</strong> program.
                </span>
              </li>
            </ul>

            <!-- Link to Events Tab Callout -->
            <div class="p-4 rounded-2xl bg-[#0e0716]/60 border border-[#5F259F]/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-inner">
              <div class="space-y-0.5">
                <p class="text-xs sm:text-sm font-semibold text-white">
                  Want to see our upcoming schedule?
                </p>
                <p class="text-[11px] text-neutral-400">
                  Head over to the Events tab to browse meeting dates, workshops, and firm sessions.
                </p>
              </div>
              <a 
                href="/events" 
                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#5F259F] hover:bg-[#742ac4] text-white text-xs font-bold transition whitespace-nowrap shadow-md shadow-[#5F259F]/20"
              >
                <span>Check Events Tab</span>
                <span>→</span>
              </a>
            </div>

          </div>

        </div>
      </section>

      <!-- Executive Board Section -->
      <section id="officers" class="space-y-6">
        <div class="flex items-center justify-between border-b border-[#5F259F]/30 pb-3">
          <h2 class="text-2xl font-bold tracking-tight text-white">Executive Board</h2>
          <span class="text-xs text-neutral-400">2026 – 2027 Officers</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
          {officers.map((officer) => (
            <div class="p-4 rounded-2xl bg-[#190e2b]/60 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition flex flex-col items-center text-center relative group">
              
              <!-- LinkedIn Profile Link -->
              {officer.linkedin && (
                <a 
                  href={officer.linkedin} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="absolute top-3 right-3 text-neutral-400 hover:text-[#FFC72A] transition"
                  title={`${officer.name}'s LinkedIn`}
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26Z" />
                  </svg>
                </a>
              )}

              <!-- Officer Photo -->
              <img 
                src={officer.photo} 
                alt={officer.name} 
                class="w-16 h-16 rounded-full object-cover border-2 border-[#5F259F] mb-3 bg-[#281344] group-hover:border-[#FFC72A] transition"
                onerror="this.src='https://via.placeholder.com/150'"
              />

              <!-- Name & Role -->
              <h3 class="font-bold text-sm text-white group-hover:text-[#FFC72A] transition leading-snug">
                {officer.name}
              </h3>
              <span class="text-[11px] font-medium text-[#FFC72A] tracking-wide mt-1">
                {officer.role}
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- Useful Links & Resources Section -->
      <section id="resources" class="space-y-6">
        <h2 class="text-2xl font-bold tracking-tight text-white border-b border-[#5F259F]/30 pb-3">Useful Links</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          <a href="https://hunter.cuny.edu" target="_blank" rel="noopener noreferrer" class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition block">
            <h3 class="text-base font-bold text-white mb-1">Hunter Catalog</h3>
            <p class="text-xs text-neutral-400">Official Hunter degree roadmaps and prerequisites.</p>
          </a>
          <a href="https://www.nasba.org" target="_blank" rel="noopener noreferrer" class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition block">
            <h3 class="text-base font-bold text-white mb-1">NASBA Portal</h3>
            <p class="text-xs text-neutral-400">New York State CPA exam credit requirements and licensing.</p>
          </a>
          <a href="https://www.irs.gov/individuals/free-tax-return-preparation-for-qualifying-taxpayers" target="_blank" rel="noopener noreferrer" class="p-5 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 hover:border-[#FFC72A]/50 transition block">
            <h3 class="text-base font-bold text-white mb-1">IRS VITA Program</h3>
            <p class="text-xs text-neutral-400">Federal guidelines and client qualification thresholds.</p>
          </a>
        </div>
      </section>

      <!-- Contact Section -->
      <section id="contact" class="p-8 rounded-3xl bg-gradient-to-br from-[#190e2b] to-[#0e0716] border border-[#5F259F]/40 space-y-6">
        <div class="space-y-2">
          <h2 class="text-2xl font-bold text-white">Get in Touch</h2>
          <p class="text-neutral-300 text-sm max-w-xl leading-relaxed">
            Have questions about society events, corporate sponsorships, or becoming a VITA volunteer? Reach out directly to our e-board.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-[#5F259F]/30">
          <div class="flex items-center gap-2">
            <span class="text-xs text-neutral-400">Email:</span>
            <a 
              href="mailto:accountingsocietyhc@gmail.com" 
              class="inline-flex items-center gap-2 text-sm font-semibold text-[#FFC72A] hover:underline transition"
            >
              <svg class="w-4 h-4 text-[#FFC72A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              accountingsocietyhc@gmail.com
            </a>
