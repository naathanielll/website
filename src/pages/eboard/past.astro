---
// src/pages/eboard/past.astro
import '../../styles/global.css';

const pastTerms = [
  {
    term: "2025 – 2026 Executive Board",
    roles: ["President", "Vice President", "Treasurer", "Secretary", "Director of Marketing", "Director of Events"]
  },
  {
    term: "2024 – 2025 Executive Board",
    roles: ["President", "Vice President", "Treasurer", "Secretary"]
  }
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Past Executive Boards | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950 flex flex-col justify-between">

    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Past Leadership & Alumni
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-12 space-y-12 w-full flex-1">
      <div class="text-center space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#c084fc] tracking-tight">
          Past Executive Boards
        </h1>
        <p class="text-sm sm:text-base text-neutral-300 max-w-xl mx-auto">
          Recognizing the former student officers and alumni who have shaped the Hunter College Accounting Society.
        </p>
        <div class="w-24 h-1 bg-[#FFC72A] rounded-full mx-auto mt-4"></div>
      </div>

      {pastTerms.map((termGroup) => (
        <section class="space-y-6">
          <div class="border-b border-[#5F259F]/30 pb-3 flex items-center justify-between">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">{termGroup.term}</h2>
            <span class="text-xs text-[#FFC72A] font-semibold uppercase tracking-wider">Alumni Directory</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            {termGroup.roles.map((role) => (
              <div class="p-5 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 flex flex-col items-center text-center space-y-3">
                <div class="w-16 h-16 rounded-full bg-[#0e0716]/60 border-2 border-dashed border-[#5F259F]/50 flex items-center justify-center text-neutral-500">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="font-bold text-sm text-neutral-300">Name Pending</h3>
                  <span class="text-xs font-semibold text-[#FFC72A] block">{role}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </main>

    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society. All rights reserved.</p>
    </footer>

  </body>
</html>
