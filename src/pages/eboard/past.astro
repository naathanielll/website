---
// src/pages/eboard/past.astro
import '../../styles/global.css';
import pastOfficers from '../../data/past-officers.json';

// Group past officers automatically by the "term" field
const terms = [...new Set(pastOfficers.map((o) => o.term || 'Past Officers'))];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Past Executive Boards | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950 flex flex-col justify-between">

    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Past Leadership & Alumni
          </span>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-12 space-y-12 w-full flex-1">
      <div class="text-center space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#c084fc] tracking-tight">
          Past Executive Boards
        </h1>
        <p class="text-sm sm:text-base text-neutral-300 max-w-xl mx-auto">
          Recognizing the former student officers and alumni who have built and led the Hunter College Accounting Society.
        </p>
        <div class="w-24 h-1 bg-[#FFC72A] rounded-full mx-auto mt-4"></div>
      </div>

      {terms.map((termName) => {
        const membersInTerm = pastOfficers.filter((o) => (o.term || 'Past Officers') === termName);
        return (
          <section class="space-y-6">
            <div class="border-b border-[#5F259F]/30 pb-3 flex items-center justify-between">
              <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">{termName}</h2>
              <span class="text-xs text-[#FFC72A] font-semibold uppercase tracking-wider">Alumni Directory</span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
              {membersInTerm.map((officer) => (
                <div class="p-5 rounded-2xl bg-[#190e2b]/50 border border-[#5F259F]/30 flex flex-col items-center text-center relative group">
                  {officer.linkedin && (
                    <a 
                      href={officer.linkedin} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="absolute top-3 right-3 text-neutral-400 hover:text-[#FFC72A] transition"
                      title={`${officer.name}'s LinkedIn`}
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26Z" />
                      </svg>
                    </a>
                  )}

                  {officer.photo ? (
                    <img 
                      src={officer.photo} 
                      alt={officer.name || 'Alumni Photo'} 
                      class="w-16 h-16 rounded-full object-cover border-2 border-[#5F259F] mb-3 bg-[#281344] group-hover:border-[#FFC72A] transition"
                      onerror="this.src='/logo.png'"
                    />
                  ) : (
                    <div class="w-16 h-16 rounded-full bg-[#0e0716]/60 border-2 border-dashed border-[#5F259F]/50 flex items-center justify-center text-neutral-500 mb-3">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    </div>
                  )}

                  <div class="space-y-1">
                    <h3 class="font-bold text-sm text-neutral-200">
                      {officer.name || 'Name Pending'}
                    </h3>
                    <span class="text-xs font-semibold text-[#FFC72A] block">
                      {officer.role}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </main>

    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society. All rights reserved.</p>
    </footer>

  </body>
</html>
