---
// src/pages/events.astro
import '../styles/global.css';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Events & Calendar | Hunter College Accounting Society</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0e0716] text-neutral-100 min-h-screen font-sans antialiased selection:bg-[#FFC72A] selection:text-neutral-950 flex flex-col justify-between">

    <!-- Top Sticky Navigation Header -->
    <header class="border-b border-[#5F259F]/30 bg-[#0e0716]/95 sticky top-0 z-50 backdrop-blur-md px-6 py-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="text-sm font-bold text-white hover:text-[#FFC72A] transition flex items-center gap-2">
          <span>← Back to Home</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#FFC72A]"></span>
          <span class="text-xs sm:text-sm uppercase tracking-wider text-[#FFC72A] font-bold">
            Events & Calendar
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-6 py-12 space-y-10 w-full flex-1">
      
      <!-- Page Hero Header -->
      <div class="text-center space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#c084fc] tracking-tight">
          Upcoming Events Calendar
        </h1>
        <p class="text-sm sm:text-base text-neutral-300 max-w-xl mx-auto leading-relaxed">
          Stay up to date with society general meetings, firm info sessions, technical workshops, and VITA volunteer schedules.
        </p>
        <div class="w-full h-1 bg-gradient-to-r from-[#FFC72A] via-[#FFD700] to-[#FFC72A] rounded-full mx-auto mt-4"></div>
      </div>

      <!-- Calendar Container -->
      <section class="p-4 sm:p-6 rounded-3xl bg-[#190e2b]/70 border border-[#5F259F]/40 shadow-2xl space-y-4">
        <div class="rounded-2xl overflow-hidden border border-[#5F259F]/40 bg-white shadow-inner">
          <iframe 
            src="https://calendar.google.com/calendar/embed?src=9a06d51ed8d4cb33b140c5ac9a04842c7e21d43268567ecc26524e4702ede255%40group.calendar.google.com&ctz=America%2FNew_York" 
            style="border: 0" 
            class="w-full h-[650px] sm:h-[750px]" 
            frameborder="0" 
            scrolling="no"
            loading="lazy"
          ></iframe>
        </div>

        <p class="text-xs text-neutral-400 text-center">
          💡 <strong>Tip:</strong> Click on any event to view location details, or use the <strong>+ Google Calendar</strong> button in the bottom-right corner of the calendar to sync our events directly to your personal device.
        </p>
      </section>

      <!-- Contact Notice -->
      <section class="p-6 rounded-2xl bg-[#190e2b]/40 border border-[#5F259F]/30 text-center space-y-2">
        <p class="text-xs sm:text-sm text-neutral-300">
          Have an event or firm collaboration inquiry? Contact our e-board at 
          <a href="mailto:accountingsocietyhc@gmail.com" class="text-[#FFC72A] font-semibold underline hover:text-[#ffe07b] transition ml-1">
            accountingsocietyhc@gmail.com
          </a>.
        </p>
      </section>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#5F259F]/20 py-8 px-6 text-center text-xs text-neutral-400 mt-12">
      <p>© {new Date().getFullYear()} Hunter College Accounting Society • Events & Schedules</p>
    </footer>

  </body>
</html>
